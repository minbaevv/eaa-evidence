APP_BASE_URL=http://127.0.0.1:8000
DATABASE_PATH=./data/eaa_evidence.db
MAX_PAGES=3
SCAN_TIMEOUT_MS=45000
ALLOW_PRIVATE_URLS=false
MAX_NODES_PER_ISSUE=10
# Optional: msedge, chrome, or empty to use bundled Chromium first.
BROWSER_CHANNEL=
# Optional: require X-API-Key header on POST /api/scans. Empty = open (dev only).
API_KEY=
# Max scan submissions per IP per hour on POST /scan and POST /api/scans.
SCAN_RATE_LIMIT_PER_HOUR=60
# AXE_PATH=./app/static/vendor/axe.min.js
